# Paste the block from your kickstart email over the values below.
ORQ_API_KEY=
# Your project in the workshop workspace; your entities live under <ORQ_PROJECT>/workshop.
ORQ_PROJECT=
# Your seat. Every entity you create starts with it (ws07-refund-agent), so seats never collide.
WS_PREFIX=
# The workspace slug used for trace links. Blank also defaults to this workshop workspace.
ORQ_WORKSPACE=kickstartai-workshop-2026
# Base URL of orq. Leave as is.
ORQ_BASE_URL=https://my.orq.ai

# Models, provider/model. The agent, the simulator and the judge all use them.
MODEL=openai/gpt-6-luna
JUDGE_MODEL=openai/gpt-6-luna
# Models evaluatorq's `eq` CLI uses (dashboard, insights). Every model named here must be enabled in the workspace.
EVALUATORQ_FAST_MODEL=openai/gpt-6-luna
EVALUATORQ_SMART_MODEL=openai/gpt-6-luna
EVALUATORQ_CLASSIFIER_MODEL=typesafe/jev-latest
EVALUATORQ_EMBEDDING_MODEL=openai/text-embedding-3-large

# Optional. Leave these commented out unless you need them.
# Store your entities somewhere other than <ORQ_PROJECT>/workshop (only if your kickstart email gives a path).
# ORQ_PATH=
# Where `make simulate-agent` writes its reports (<dir>/sim-runs/). Default: .evaluatorq in the repo root.
# EVALUATORQ_DIR=
# ORQ_ENV_FILE is read before this file is loaded, so it cannot be set here. Export it in your shell to
# load a different env file instead of this one; keep that file out of the repo, or name it .env.<something>.
